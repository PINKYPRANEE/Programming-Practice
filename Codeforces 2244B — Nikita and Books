#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;

    vector<long long> a(n);

    for (auto &x : a)
        cin >> x;

    for (int i = 0; i + 1 < n; i++) {
        if (a[i] >= a[i + 1]) {
            long long need = a[i] - a[i + 1] + 1;

            // We need to move 'need' books from i to i+1.
            // Stack i must retain at least 1 book.
            if (a[i] - need < 1) {
                cout << "NO\n";
                return;
            }

            a[i] -= need;
            a[i + 1] += need;
        }
    }

    // Check whether the final array is strictly increasing.
    for (int i = 0; i + 1 < n; i++) {
        if (a[i] >= a[i + 1]) {
            cout << "NO\n";
            return;
        }
    }

    cout << "YES\n";
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}

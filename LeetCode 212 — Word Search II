class Solution {
public:

    struct TrieNode {
        TrieNode* child[26];
        string word;

        TrieNode() {
            word = "";

            for (int i = 0; i < 26; i++) {
                child[i] = nullptr;
            }
        }
    };

    TrieNode* root = new TrieNode();
    vector<string> ans;

    // Insert a word into Trie
    void insert(string word) {
        TrieNode* node = root;

        for (char c : word) {
            int index = c - 'a';

            if (node->child[index] == nullptr) {
                node->child[index] = new TrieNode();
            }

            node = node->child[index];
        }

        node->word = word;
    }

    void dfs(vector<vector<char>>& board,
             int r,
             int c,
             TrieNode* node) {

        // Outside board
        if (r < 0 || r >= board.size() ||
            c < 0 || c >= board[0].size()) {
            return;
        }

        // Already visited
        if (board[r][c] == '#') {
            return;
        }

        char ch = board[r][c];

        int index = ch - 'a';

        // This character is not a Trie prefix
        if (node->child[index] == nullptr) {
            return;
        }

        node = node->child[index];

        // We found a complete word
        if (node->word != "") {
            ans.push_back(node->word);

            // Avoid finding the same word again
            node->word = "";
        }

        // Mark as visited
        board[r][c] = '#';

        // Explore 4 directions

        dfs(board, r + 1, c, node); // down
        dfs(board, r - 1, c, node); // up
        dfs(board, r, c + 1, node); // right
        dfs(board, r, c - 1, node); // left

        // Backtrack
        board[r][c] = ch;
    }

    vector<string> findWords(vector<vector<char>>& board,
                             vector<string>& words) {

        // 1. Build Trie
        for (string word : words) {
            insert(word);
        }

        // 2. Start DFS from every cell
        int m = board.size();
        int n = board[0].size();

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                dfs(board, i, j, root);
            }
        }

        return ans;
    }
};

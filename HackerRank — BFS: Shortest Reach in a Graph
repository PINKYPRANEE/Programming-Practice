#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int q;
    cin >> q;

    while (q--) {

        int n, m;
        cin >> n >> m;

        vector<vector<int>> graph(n + 1);

        // Build graph
        for (int i = 0; i < m; i++) {
            int u, v;
            cin >> u >> v;

            graph[u].push_back(v);
            graph[v].push_back(u);
        }

        int s;
        cin >> s;

        // Distance array
        vector<int> dist(n + 1, -1);

        queue<int> q;

        dist[s] = 0;
        q.push(s);

        // BFS
        while (!q.empty()) {
            int u = q.front();
            q.pop();

            for (int v : graph[u]) {

                // Not visited yet
                if (dist[v] == -1) {
                    dist[v] = dist[u] + 6;
                    q.push(v);
                }
            }
        }

        // Print distances except starting node
        for (int i = 1; i <= n; i++) {
            if (i == s)
                continue;

            cout << dist[i] << " ";
        }

        cout << '\n';
    }

    return 0;
}

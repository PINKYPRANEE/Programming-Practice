#include <bits/stdc++.h>
using namespace std;

class SegmentTree {
    int n;
    vector<long long> tree;

public:

    SegmentTree(vector<long long>& a) {
        n = a.size();
        tree.resize(4 * n);
        build(a, 1, 0, n - 1);
    }

    void build(vector<long long>& a, int node, int l, int r) {

        if (l == r) {
            tree[node] = a[l];
            return;
        }

        int mid = (l + r) / 2;

        build(a, 2 * node, l, mid);
        build(a, 2 * node + 1, mid + 1, r);

        tree[node] = min(tree[2 * node],
                         tree[2 * node + 1]);
    }

    long long query(int node, int l, int r,
                    int ql, int qr) {

        // Completely outside
        if (qr < l || r < ql) {
            return LLONG_MAX;
        }

        // Completely inside
        if (ql <= l && r <= qr) {
            return tree[node];
        }

        int mid = (l + r) / 2;

        long long left =
            query(2 * node, l, mid, ql, qr);

        long long right =
            query(2 * node + 1, mid + 1, r, ql, qr);

        return min(left, right);
    }

    long long query(int l, int r) {
        return query(1, 0, n - 1, l, r);
    }
};

int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, q;
    cin >> n >> q;

    vector<long long> a(n);

    for (auto& x : a)
        cin >> x;

    SegmentTree st(a);

    while (q--) {

        int a, b;
        cin >> a >> b;

        // CSES uses 1-based indexing
        a--;
        b--;

        cout << st.query(a, b) << '\n';
    }

    return 0;
}

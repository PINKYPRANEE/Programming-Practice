#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N, M;
    cin >> N >> M;

    vector<int> diff(N + 2, 0);

    for (int i = 0; i < M; i++) {
        int L, R;
        cin >> L >> R;

        diff[L]++;
        diff[R + 1]--;
    }

    int current = 0;
    int answer = M;

    for (int wall = 1; wall <= N; wall++) {
        current += diff[wall];
        answer = min(answer, current);
    }

    cout << answer << '\n';

    return 0;
}

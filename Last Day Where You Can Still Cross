class Solution {
public:
    vector<int> parent, sz;

    int find(int x) {
        if (parent[x] == x)
            return x;
        return parent[x] = find(parent[x]);
    }

    void unite(int a, int b) {
        int pa = find(a);
        int pb = find(b);

        if (pa == pb) return;

        if (sz[pa] < sz[pb])
            swap(pa, pb);

        parent[pb] = pa;
        sz[pa] += sz[pb];
    }

    int latestDayToCross(int row, int col, vector<vector<int>>& cells) {

        int n = row * col;
        int TOP = n;
        int BOTTOM = n + 1;

        parent.resize(n + 2);
        sz.assign(n + 2, 1);

        for (int i = 0; i < n + 2; i++)
            parent[i] = i;

        vector<vector<int>> grid(row, vector<int>(col, 0));

        vector<pair<int,int>> dir = {
            {-1,0}, {1,0}, {0,-1}, {0,1}
        };

        // Process in reverse
        for (int day = n - 1; day >= 0; day--) {

            int r = cells[day][0] - 1;
            int c = cells[day][1] - 1;

            grid[r][c] = 1;      // Make this cell land

            int id = r * col + c;

            // Connect with top virtual node
            if (r == 0)
                unite(id, TOP);

            // Connect with bottom virtual node
            if (r == row - 1)
                unite(id, BOTTOM);

            // Connect with neighbouring land cells
            for (auto &d : dir) {
                int nr = r + d.first;
                int nc = c + d.second;

                if (nr >= 0 && nr < row &&
                    nc >= 0 && nc < col &&
                    grid[nr][nc]) {

                    int nid = nr * col + nc;
                    unite(id, nid);
                }
            }

            // Top connected to Bottom
            if (find(TOP) == find(BOTTOM))
                return day;
        }

        return 0;
    }
};

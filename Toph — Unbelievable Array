#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    for (int tc = 1; tc <= T; tc++) {
        int n, q;
        cin >> n >> q;

        vector<int> A(n);

        for (int i = 0; i < n; i++) {
            cin >> A[i];
        }

        // parent[x] = current representative of x
        vector<int> parent(100001);

        for (int i = 1; i <= 100000; i++) {
            parent[i] = i;
        }

        function<int(int)> find = [&](int x) {
            if (parent[x] == x)
                return x;

            return parent[x] = find(parent[x]);
        };

        cout << "Case " << tc << ":\n";

        while (q--) {
            int type;
            cin >> type;

            if (type == 1) {
                int x, y;
                cin >> x >> y;

                x = find(x);
                y = find(y);

                if (x != y) {
                    parent[x] = y;
                }
            }
            else {
                int idx;
                cin >> idx;

                cout << find(A[idx - 1]) << '\n';
            }
        }
    }

    return 0;
}

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N, Q;
    cin >> N >> Q;

    vector<int> A(N, 0);

    // Indices whose values are currently > 0
    vector<int> active;

    int ans = 0;

    while (Q--) {
        int type;
        cin >> type;

        if (type == 1) {
            int x;
            cin >> x;
            x--;  // convert to 0-based indexing

            // If it was zero, it becomes active
            if (A[x] == 0) {
                active.push_back(x);
            }

            // Remove old value from XOR
            ans ^= A[x];

            // Increase
            A[x]++;

            // Add new value to XOR
            ans ^= A[x];
        }
        else {
            vector<int> nextActive;

            for (int x : active) {

                // Remove old value
                ans ^= A[x];

                // Decrease
                A[x]--;

                // Add new value
                ans ^= A[x];

                // Keep it active only if still positive
                if (A[x] > 0) {
                    nextActive.push_back(x);
                }
            }

            active = nextActive;
        }

        cout << ans << '\n';
    }

    return 0;
}

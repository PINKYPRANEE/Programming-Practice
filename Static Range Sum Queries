#include <iostream>
#include <vector>
using namespace std;
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int n, q;
    cin >> n >> q;
 
    // Prefix sum array
    vector<long long> prefix(n + 1, 0);
 
    // Read array and build prefix sum
    for (int i = 1; i <= n; i++) {
        long long x;
        cin >> x;
        prefix[i] = prefix[i - 1] + x;
    }
 
    // Process each query
    while (q--) {
        int a, b;
        cin >> a >> b;
 
        // Sum from index a to b
        cout << prefix[b] - prefix[a - 1] << "\n";
    }
 
    return 0;
}
